#include <iostream>
#include <iomanip> // for 2 decimal places trick
using namespace std;

int main() {
    // Purpose - Create a simple receipt
    // should also handle sales tax (0%)

    // Declare our variables
    string item = "Pizza";
    double item_price = 5.99;
    double tax_percent = 0.00; // 0% is 0/100
    double tax_amount; // Tax in $
    double total; // Price + tax

    // Greet user and take the order
    cout << "Welcome to our CSC 134 Restaurant!" << endl;
    cout << "You ordered one " << item << "." << endl;

    // Calculate the meal price
    // Calculate the sales tax and the total price
    tax_amount = item_price * tax_percent; // take 0% of the item
    total = item_price + tax_amount;

    // Print the reciept
    cout << setprecision(2) << fixed;
    cout << "Thank you for shopping with us" << endl;
    cout << "=============================" << endl;
    cout << item << "\t\t$" << item_price;
    cout << "Tax" << "\t\t$" << tax_amount;
    cout << "=============================" << endl;
    cout << "Total" << "\t\t$" << total << endl;
    cout << endl;

    return 0; // no errors
}
