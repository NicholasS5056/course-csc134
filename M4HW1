#include <iostream>
using namespace std;

int main() {
    // Declare variables
    int firstNum, secondNum, answer;

    // Ask the user for a number
    cout << "Enter a number from 1 to 12: ";
    cin >> firstNum;

    // Start the counter
    secondNum = 1;

    // Display the multiplication table
    while (secondNum <= 12) {
        answer = firstNum * secondNum;

        cout << firstNum << " times " << secondNum;
        cout << " is " << answer << "." << endl;

        secondNum++;
    }

    return 0;
}